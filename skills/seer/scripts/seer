#!/usr/bin/env python3
import argparse
import importlib.util
import json
import math
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path
from typing import Optional

from result_guidance import with_guidance


SCRIPTS = Path(__file__).resolve().parent
ACCESSIBILITY_APPLESCRIPT = """
tell application "System Events"
  repeat with targetProcess in (application processes whose visible is true)
    try
      if (count of windows of targetProcess) > 0 then
        set ignoredPosition to position of window 1 of targetProcess
        set ignoredSize to size of window 1 of targetProcess
        return "true"
      end if
    end try
  end repeat
  return "false"
end tell
"""
FRONTMOST_APPLESCRIPT = "tell application \"System Events\" to get name of first application process whose frontmost is true"
WINDOWS_JXA = r"""
ObjC.import("CoreGraphics");

function run() {
  const events = Application("System Events");
  const processes = {};
  const seen = {};
  let visibleProcesses = 0;
  let accessibleProcesses = 0;
  let skippedProcesses = 0;
  let frontmostProcess = null;

  for (const process of events.applicationProcesses.whose({visible: true})()) {
    try {
      const pid = process.unixId();
      if (seen[pid]) continue;
      seen[pid] = true;
      visibleProcesses++;
      const processName = process.name();
      const frontmost = process.frontmost();
      process.windows();
      processes[pid] = {name: processName, frontmost: frontmost, index: 0};
      accessibleProcesses++;
      if (frontmost) frontmostProcess = processName;
    } catch (_) {
      skippedProcesses++;
    }
  }

  const rawWindows = $.CGWindowListCopyWindowInfo(
    $.kCGWindowListOptionOnScreenOnly | $.kCGWindowListExcludeDesktopElements,
    0
  );
  if (!rawWindows) throw new Error("window server unavailable");

  const windows = ObjC.deepUnwrap(ObjC.castRefToObject(rawWindows));
  const result = [];
  let skippedWindows = 0;

  for (const window of windows) {
    try {
      if (Number(window.kCGWindowLayer) !== 0 || window.kCGWindowIsOnscreen === false ||
          Number(window.kCGWindowAlpha) <= 0 || Number(window.kCGWindowSharingState) === 0) continue;
      const windowId = Number(window.kCGWindowNumber);
      const pid = Number(window.kCGWindowOwnerPID);
      const process = processes[pid];
      if (!process) continue;
      const bounds = window.kCGWindowBounds || {};
      const x = Number(bounds.X);
      const y = Number(bounds.Y);
      const width = Number(bounds.Width);
      const height = Number(bounds.Height);
      if (!Number.isInteger(windowId) || windowId <= 0 ||
          !Number.isInteger(pid) || pid <= 0 ||
          !Number.isFinite(x) || !Number.isFinite(y) ||
          !Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) {
        skippedWindows++;
        continue;
      }

      process.index++;
      result.push({
        window_id: windowId,
        process: process.name,
        index: process.index,
        title: typeof window.kCGWindowName === "string" ? window.kCGWindowName : "",
        frontmost: process.frontmost,
        bounds: {x: x, y: y, width: width, height: height}
      });
    } catch (_) {
      skippedWindows++;
    }
  }

  return JSON.stringify({
    windows: result,
    visible_processes: visibleProcesses,
    accessible_processes: accessibleProcesses,
    skipped_processes: skippedProcesses,
    skipped_windows: skippedWindows,
    frontmost_process: frontmostProcess
  });
}
"""


def emit(payload: dict) -> None:
    print(json.dumps(with_guidance(payload), separators=(",", ":")))


class SeerCLIError(Exception):
    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code
        self.message = message


class CLIUsageError(Exception):
    def __init__(self, parser: argparse.ArgumentParser, message: str):
        super().__init__(message)
        self.parser = parser
        self.message = message


class SeerArgumentParser(argparse.ArgumentParser):
    def __init__(self, *args, **kwargs):
        # Exact option spelling keeps CLI and MCP policy checks unambiguous.
        super().__init__(*args, **{**kwargs, "allow_abbrev": False})

    def error(self, message: str) -> None:
        raise CLIUsageError(self, message)


def run(command: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(command, capture_output=True, text=True)
    except FileNotFoundError as exc:
        raise SeerCLIError("dependency_missing", f"required command not found: {command[0]}") from exc
    except PermissionError as exc:
        raise SeerCLIError("subprocess_failed", f"could not execute {command[0]}: {exc.strerror}") from exc
    except UnicodeError as exc:
        raise SeerCLIError("invalid_subprocess_output", f"command returned invalid text: {command[0]}") from exc
    except OSError as exc:
        raise SeerCLIError("subprocess_failed", f"could not run {command[0]}: {exc.strerror or exc}") from exc


def forward_stderr(result: subprocess.CompletedProcess[str]) -> None:
    if result.stderr:
        sys.stderr.write(result.stderr)


def emit_error(operation: Optional[str], code: str, message: str, *, extra: Optional[dict] = None) -> int:
    payload = {
        "schema_version": 1,
        "operation": operation,
        "status": "error",
        "error": {"code": code, "message": message},
    }
    if extra:
        payload.update(extra)
    emit(payload)
    print(f"error: {message}", file=sys.stderr)
    return 2


def child_error_code(stderr: str, default: str = "subprocess_failed") -> str:
    diagnostic = stderr.lower()
    if any(
        phrase in diagnostic
        for phrase in (
            "required command not found",
            "command not found",
            "no module named 'pil'",
            "no module named \"pil\"",
            "pillow is required",
        )
    ):
        return "dependency_missing"
    if any(
        phrase in diagnostic
        for phrase in (
            "must be a finite number",
            "cannot be used together",
            "unknown option:",
            "requires a value",
            "requires an id",
            "window id must be",
        )
    ):
        return "invalid_arguments"
    if any(
        phrase in diagnostic
        for phrase in (
            "read-only file system",
            "no space left",
            "not a directory",
            "current image not found",
            "no such file or directory",
        )
    ):
        return "filesystem_error"
    return default


def child_error_message(stderr: str, fallback: str) -> str:
    for line in stderr.splitlines():
        stripped = line.strip()
        if stripped.startswith("error:"):
            return stripped[len("error:"):].strip()
    return fallback


def parse_window_id(value: str) -> int:
    try:
        window_id = int(value, 10)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("window ID must be an integer") from exc
    if not 1 <= window_id <= 0xFFFFFFFF:
        raise argparse.ArgumentTypeError("window ID must be between 1 and 4294967295")
    return window_id


def window_snapshot(osascript: str):
    result = run([osascript, "-l", "JavaScript", "-e", WINDOWS_JXA])
    if result.returncode != 0:
        return None, result
    try:
        snapshot = json.loads(result.stdout)
        if not isinstance(snapshot, dict) or not isinstance(snapshot.get("windows"), list):
            raise ValueError
        for key in (
            "visible_processes",
            "accessible_processes",
            "skipped_processes",
            "skipped_windows",
        ):
            if not isinstance(snapshot.get(key), int):
                raise ValueError
        for window in snapshot["windows"]:
            window_id = window.get("window_id") if isinstance(window, dict) else None
            if isinstance(window_id, bool) or not isinstance(window_id, int) or not 1 <= window_id <= 0xFFFFFFFF:
                raise ValueError
    except (json.JSONDecodeError, TypeError, ValueError):
        return None, result
    return snapshot, result


def doctor(_: argparse.Namespace) -> int:
    platform_ok = sys.platform == "darwin"
    osascript = shutil.which("osascript")
    screencapture = shutil.which("screencapture")
    pillow = importlib.util.find_spec("PIL") is not None
    accessibility = False
    frontmost = None

    if platform_ok and osascript:
        try:
            access_result = run([osascript, "-e", ACCESSIBILITY_APPLESCRIPT])
            accessibility = (
                access_result.returncode == 0
                and access_result.stdout.strip().lower() == "true"
            )
        except SeerCLIError:
            accessibility = False

        try:
            frontmost_result = run([osascript, "-e", FRONTMOST_APPLESCRIPT])
            if frontmost_result.returncode == 0 and frontmost_result.stdout.strip():
                frontmost = frontmost_result.stdout.strip()
        except SeerCLIError:
            frontmost = None

    ready = platform_ok and bool(osascript) and bool(screencapture) and pillow and accessibility
    capabilities = {
        "platform": {"available": platform_ok, "value": sys.platform},
        "window_query": {
            "available": bool(osascript),
            "authorized": accessibility,
        },
        "screen_capture": {
            "available": bool(screencapture),
            "permission": "checked_on_capture",
        },
        "image_diff": {"available": pillow},
        "video": {
            "available": bool(shutil.which("ffmpeg") and shutil.which("ffprobe")),
            "required": False,
        },
    }
    if not ready:
        if not platform_ok:
            code = "platform_unsupported"
            message = "Seer requires macOS"
        elif not osascript or not screencapture or not pillow:
            code = "dependency_missing"
            message = "Seer is missing a required dependency; inspect the doctor capability report"
        else:
            code = "not_ready"
            message = "Could not confirm access to a visible window; inspect permissions and open a window"
        return emit_error(
            "doctor",
            code,
            message,
            extra={"capabilities": capabilities, "frontmost_process": frontmost},
        )
    emit(
        {
            "schema_version": 1,
            "operation": "doctor",
            "status": "pass",
            "capabilities": capabilities,
            "frontmost_process": frontmost,
        }
    )
    return 0


def windows(_: argparse.Namespace) -> int:
    if sys.platform != "darwin":
        return emit_error("windows", "platform_unsupported", "window discovery requires macOS")
    osascript = shutil.which("osascript")
    if not osascript:
        return emit_error("windows", "dependency_missing", "osascript not found")

    snapshot, result = window_snapshot(osascript)
    if snapshot is None:
        forward_stderr(result)
        if result.returncode != 0:
            code = child_error_code(result.stderr)
            message = child_error_message(result.stderr, f"window discovery failed with exit {result.returncode}")
        else:
            code = "invalid_subprocess_output"
            message = "window discovery returned invalid data"
        return emit_error("windows", code, message)
    if snapshot["visible_processes"] and not snapshot["accessible_processes"]:
        return emit_error(
            "windows", "accessibility_required", "window discovery requires Accessibility permission"
        )

    emit(
        {
            "schema_version": 1,
            "operation": "windows",
            "status": "pass",
            "partial": bool(snapshot["skipped_processes"] or snapshot["skipped_windows"]),
            "processes_skipped": snapshot["skipped_processes"],
            "windows_skipped": snapshot["skipped_windows"],
            "windows": snapshot["windows"],
        }
    )
    return 0


def capture(args: argparse.Namespace) -> int:
    from capture_metadata import utc_now

    root = Path(os.environ.get("SEER_OUT_DIR", os.environ.get("SEER_TMP_DIR", ".seer")))
    destination = args.out or str(root / "capture" / f"app-window-{uuid.uuid4().hex}.png")
    started_at = utc_now()
    try:
        parent = Path(destination).expanduser().resolve().parent
        parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".seer-capture-", dir=parent) as directory:
            staged = Path(directory) / "current.png"
            return capture_to_destination(args, staged, destination, started_at)
    except OSError as exc:
        return emit_error("capture", "filesystem_error", f"could not prepare capture: {exc}")


def capture_to_destination(args, staged, destination, started_at):
    from capture_metadata import describe_capture, publish_image

    command = ["bash", str(SCRIPTS / "capture_app_window.sh")]
    if args.window_id is not None:
        command.extend(["--window-id", str(args.window_id)])
    command.append("--")
    command.append(str(staged))
    if args.process:
        command.append(args.process)

    result = run(command)
    forward_stderr(result)
    if result.returncode != 0:
        code = child_error_code(result.stderr)
        message = child_error_message(result.stderr, f"capture failed with exit {result.returncode}")
        return emit_error("capture", code, message)
    output = result.stdout.strip()
    if not output:
        return emit_error("capture", "invalid_subprocess_output", "capture did not return an image path")
    try:
        current = Path(output).expanduser().resolve()
        exists = current.is_file()
    except (OSError, RuntimeError) as exc:
        return emit_error("capture", "filesystem_error", f"could not inspect capture output: {exc}")
    if not exists:
        return emit_error("capture", "invalid_subprocess_output", f"capture did not create an image: {current}")
    if current != staged.resolve():
        return emit_error("capture", "invalid_subprocess_output", "capture returned an unexpected image path")
    try:
        metadata = describe_capture(current, window_id=args.window_id, process=args.process,
                                    started_at=started_at)
        artifacts = publish_image(current, destination, metadata)
    except ImportError:
        return emit_error("capture", "dependency_missing", "Pillow is required for capture metadata")
    except (OSError, ValueError) as exc:
        return emit_error("capture", "filesystem_error", f"could not publish capture and metadata: {exc}")

    emit(
        {
            "schema_version": 1,
            "operation": "capture",
            "status": "pass",
            "process": args.process,
            "window_id": args.window_id,
            "artifacts": artifacts,
            "capture": metadata,
        }
    )
    return 0


def verify(args: argparse.Namespace) -> int:
    command = ["bash", str(SCRIPTS / "loop_compare.sh")]
    if args.loop_dir:
        command.extend(["--loop-dir", args.loop_dir])
    if args.resize:
        command.append("--resize")
    if args.max_diff_percent is not None:
        command.extend(["--max-diff-percent", args.max_diff_percent])
    for rectangle in args.ignore_rect:
        command.extend(["--ignore-rect", rectangle])
    if args.create_baseline:
        command.append("--create-baseline")
    if args.update_baseline:
        command.append("--update-baseline")
    command.extend(["--", args.current, args.baseline])

    result = run(command)
    forward_stderr(result)
    if result.returncode == 2:
        try:
            error_payload = json.loads(result.stdout)
            if (isinstance(error_payload, dict) and error_payload.get("schema_version") == 1
                    and error_payload.get("operation") == "verify"
                    and error_payload.get("status") == "error"
                    and isinstance(error_payload.get("error"), dict)
                    and isinstance(error_payload["error"].get("code"), str)
                    and isinstance(error_payload["error"].get("message"), str)):
                emit(error_payload)
                return 2
        except (ValueError, TypeError):
            pass
        code = child_error_code(result.stderr)
        message = child_error_message(result.stderr, "verification command failed")
        return emit_error("verify", code, message)
    if result.returncode not in (0, 1, 3):
        code = child_error_code(result.stderr)
        message = child_error_message(result.stderr, f"verification failed with unexpected exit {result.returncode}")
        return emit_error("verify", code, message)
    try:
        payload = json.loads(result.stdout)
        if not isinstance(payload, dict):
            raise ValueError
    except (json.JSONDecodeError, ValueError):
        if result.stderr:
            code = child_error_code(result.stderr)
            message = child_error_message(result.stderr, "verification command returned invalid data")
            return emit_error("verify", code, message)
        return emit_error("verify", "invalid_subprocess_output", "verification returned invalid data")

    expected_status = {0: "pass", 1: "fail", 3: "needs_baseline"}[result.returncode]
    if payload.get("status") != expected_status:
        return emit_error("verify", "invalid_subprocess_output", "verification returned invalid data")

    emit(payload)
    return result.returncode


def positive_seconds(value):
    try:
        number = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a positive finite number of seconds") from exc
    if not math.isfinite(number) or number <= 0:
        raise argparse.ArgumentTypeError("must be a positive finite number of seconds")
    return number


def parse_region(value):
    try:
        parts = tuple(float(item) for item in value.split(","))
    except ValueError as exc:
        raise argparse.ArgumentTypeError("region must be X,Y,WIDTH,HEIGHT in window points") from exc
    if (len(parts) != 4 or not all(math.isfinite(item) for item in parts)
            or parts[0] < 0 or parts[1] < 0 or parts[2] <= 0 or parts[3] <= 0):
        raise argparse.ArgumentTypeError("region needs finite nonnegative coordinates and positive dimensions")
    return parts


def confidence(value):
    try:
        number = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("confidence must be between 0 and 1") from exc
    if not math.isfinite(number) or not 0 <= number <= 1:
        raise argparse.ArgumentTypeError("confidence must be finite and between 0 and 1")
    return number


def condition_options(args):
    return {key: getattr(args, key) for key in
            ("text", "text_absent", "enabled", "disabled", "role", "match", "min_confidence")}


def nonempty(value):
    if not value.strip():
        raise argparse.ArgumentTypeError("condition and selector strings must not be empty")
    return value


def ui_condition_error(args):
    control = args.enabled is not None or args.disabled is not None
    if control and args.source == "ocr":
        return "control state assertions require Accessibility (--source ax)"
    if args.role and not control:
        return "--role requires --enabled or --disabled"
    return None


def inspect_ui(args):
    from ui_inspect import InspectionError, inspect_ui as read_ui
    try:
        payload = read_ui(args.window_id, source=args.source, region=args.region, timeout=args.timeout)
    except InspectionError as exc:
        return emit_error("inspect", exc.code, exc.message, extra={"details": exc.details})
    emit(payload)
    return 0


def assert_ui(args):
    invalid = ui_condition_error(args)
    if invalid:
        return emit_error("assert", "invalid_arguments", invalid)
    from ui_inspect import InspectionError, inspect_ui as read_ui
    from ui_assertions import evaluate
    try:
        snapshot = read_ui(args.window_id, source=args.source, region=args.region, timeout=args.timeout)
        payload = evaluate(snapshot, **condition_options(args))
    except InspectionError as exc:
        return emit_error("assert", exc.code, exc.message, extra={"details": exc.details})
    if payload.get("status") == "error":
        print(f"error: {payload['error']['message']}", file=sys.stderr)
    emit(payload)
    return {"pass": 0, "fail": 1, "error": 2}[payload["status"]]


def wait(args):
    if not args.stable:
        invalid = ui_condition_error(args)
        if invalid:
            return emit_error("wait", "invalid_arguments", invalid)
        from ui_assertions import wait_for_condition
        if args.ignore_rect or args.out or args.max_diff_percent != "0" or args.stable_for != 1:
            return emit_error("wait", "invalid_arguments", "pixel comparison and output options require --stable")
        payload, code = wait_for_condition(args.window_id, timeout=args.timeout, interval=args.interval,
                                          source=args.source, region=args.region, **condition_options(args))
        if payload.get("status") == "error":
            print(f"error: {payload['error']['message']}", file=sys.stderr)
        emit(payload)
        return code
    if args.source != "ax" or args.region or args.role or args.match != "contains" or args.min_confidence != 0.8:
        return emit_error("wait", "invalid_arguments", "text, region and source options require a UI condition")
    try:
        from compare_images import ComparisonError, percentage
        from stable_wait import WaitError, wait_stable
        args.max_diff_percent = percentage(args.max_diff_percent)
        payload, code = wait_stable(args, SCRIPTS / "seer")
    except ImportError:
        return emit_error("wait", "dependency_missing", "Pillow is required for stability comparison")
    except argparse.ArgumentTypeError as exc:
        return emit_error("wait", "invalid_arguments", str(exc))
    except (ComparisonError, WaitError) as exc:
        return emit_error("wait", exc.code, exc.message,
                          extra={"details": getattr(exc, "details", {})})
    except OSError as exc:
        return emit_error("wait", "filesystem_error", str(exc))
    emit(payload)
    return code


def parser() -> argparse.ArgumentParser:
    root = SeerArgumentParser(description="Machine-readable visual verification for macOS agents.")
    commands = root.add_subparsers(dest="command", required=True, parser_class=SeerArgumentParser)

    doctor_parser = commands.add_parser("doctor", help="Check required capabilities")
    doctor_parser.add_argument("--json", action="store_true", help="Emit JSON (default)")
    doctor_parser.set_defaults(handler=doctor)

    windows_parser = commands.add_parser("windows", help="List visible app windows")
    windows_parser.add_argument("--json", action="store_true", help="Emit JSON (default)")
    windows_parser.set_defaults(handler=windows)

    capture_parser = commands.add_parser("capture", help="Capture an exact window or an app's first window")
    capture_target = capture_parser.add_mutually_exclusive_group()
    capture_target.add_argument("--window-id", type=parse_window_id, help="CGWindowID returned by windows")
    capture_target.add_argument("--process", help="Exact app process name (default: frontmost)")
    capture_parser.add_argument("--out", help="Output PNG path")
    capture_parser.add_argument("--json", action="store_true", help="Emit JSON (default)")
    capture_parser.set_defaults(handler=capture)

    def add_ui_options(command, *, window=True, timeout=True):
        if window:
            command.add_argument("--window-id", type=parse_window_id, required=True, help="Exact CGWindowID")
        command.add_argument("--source", choices=("ax", "ocr"), default="ax", help="Accessibility (default) or explicit local Vision OCR")
        command.add_argument("--region", type=parse_region, metavar="X,Y,W,H", help="Window-local points, top-left origin")
        if timeout:
            command.add_argument("--timeout", type=positive_seconds, default=30.0, help="Overall query budget, including helper build and OCR (default: 30 seconds)")

    def add_conditions(command, *, stable=False):
        conditions = command.add_mutually_exclusive_group(required=True)
        if stable:
            conditions.add_argument("--stable", action="store_true", help="Require sustained stable pixels")
        conditions.add_argument("--text", type=nonempty, help="Assert text is present")
        conditions.add_argument("--text-absent", type=nonempty, help="Assert text is absent from complete Accessibility evidence")
        conditions.add_argument("--enabled", type=nonempty, metavar="NAME", help="Assert an exactly named AX control is enabled")
        conditions.add_argument("--disabled", type=nonempty, metavar="NAME", help="Assert an exactly named AX control is disabled")
        command.add_argument("--role", type=nonempty, help="Exact Accessibility role for a control selector")
        command.add_argument("--match", choices=("contains", "exact"), default="contains", help="Case-sensitive text matching")
        command.add_argument("--min-confidence", type=confidence, default=0.8, help="Minimum OCR confidence (default: 0.8)")

    inspect_parser = commands.add_parser("inspect", help="Read UI evidence from an exact window")
    add_ui_options(inspect_parser)
    inspect_parser.add_argument("--json", action="store_true", help="Emit JSON (default)")
    inspect_parser.set_defaults(handler=inspect_ui)

    assert_parser = commands.add_parser("assert", help="Assert text or an Accessibility control state")
    add_ui_options(assert_parser)
    add_conditions(assert_parser)
    assert_parser.add_argument("--json", action="store_true", help="Emit JSON (default)")
    assert_parser.set_defaults(handler=assert_ui)

    wait_parser = commands.add_parser("wait", help="Wait for stable pixels or a UI condition in one exact window")
    add_conditions(wait_parser, stable=True)
    wait_parser.add_argument("--window-id", type=parse_window_id, required=True, help="Exact CGWindowID to sample")
    wait_parser.add_argument("--timeout", type=positive_seconds, default=10.0, help="Overall seconds budget (default: 10)")
    wait_parser.add_argument("--interval", type=positive_seconds, default=0.25, help="Seconds between captures (default: 0.25)")
    wait_parser.add_argument("--stable-for", type=positive_seconds, default=1.0, help="Sustained stable seconds (default: 1)")
    wait_parser.add_argument("--max-diff-percent", default="0", help="Allowed changed pixels from interval anchor (default: 0)")
    wait_parser.add_argument("--ignore-rect", action="append", default=[], metavar="X,Y,W,H", help="Exclude pixel rectangle; repeatable")
    wait_parser.add_argument("--out", help="Publish a stable PNG only on success")
    wait_parser.add_argument("--json", action="store_true", help="Emit JSON (default)")
    add_ui_options(wait_parser, window=False, timeout=False)
    wait_parser.set_defaults(handler=wait)

    verify_parser = commands.add_parser("verify", help="Compare an image with an approved baseline")
    verify_parser.add_argument("current", help="Current PNG path")
    verify_parser.add_argument("baseline", help="Baseline name")
    verify_parser.add_argument("--loop-dir", help="Override visual loop storage")
    verify_parser.add_argument("--resize", action="store_true", help="Resize current to baseline size")
    verify_parser.add_argument("--max-diff-percent", help="Allowed changed pixels, 0-100 (default: 0)")
    verify_parser.add_argument("--ignore-rect", action="append", default=[], metavar="X,Y,W,H", help="Exclude baseline pixel rectangle; repeatable")
    verify_parser.add_argument("--create-baseline", action="store_true", help="Create a missing baseline")
    verify_parser.add_argument("--update-baseline", action="store_true", help="Replace an existing baseline")
    verify_parser.add_argument("--json", action="store_true", help="Emit JSON (default)")
    verify_parser.set_defaults(handler=verify)
    return root


def main() -> int:
    argument_parser = parser()
    argv = sys.argv[1:]
    try:
        args = argument_parser.parse_args(argv)
    except CLIUsageError as exc:
        command_names = {"doctor", "windows", "capture", "verify", "wait", "inspect", "assert"}
        operation = argv[0] if argv and argv[0] in command_names else None
        sys.stderr.write(exc.parser.format_usage())
        return emit_error(operation, "invalid_arguments", exc.message)

    try:
        return args.handler(args)
    except SeerCLIError as exc:
        return emit_error(args.command, exc.code, exc.message)


if __name__ == "__main__":
    def terminate(signum, _frame):
        # Unwind owned subprocess cleanup when an MCP caller cancels a call.
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, terminate)
    raise SystemExit(main())
